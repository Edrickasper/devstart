#!/bin/bash

CONFIG=""
[ -f "$CONFIG" ] && source "$CONFIG"

PROJECT=$(
  find "$PROJECTS_DIR" -maxdepth "$MAX_DEPTH" -mindepth 1 \
    \( -name node_modules -o -name .git -o -name dist \
       -o -name build -o -name .cache -o -name coverage -o -name .venv \) \
    -prune -o -type d -print \
  | while IFS= read -r dir; do
      if [[ -f "$dir/package.json" || -f "$dir/angular.json" || -d "$dir/.git" ]]; then
        printf '%s|%s\n' "$dir" "${dir#"$PROJECTS_DIR"/}"
      fi
    done \
  | fzf --delimiter="|" --with-nth=2 \
        --prompt="Select Project: " \
        --tiebreak=begin \
  | cut -d'|' -f1
)

[ -z "$PROJECT" ] && exit

code "$PROJECT" &

if [ -f "$PROJECT/angular.json" ]; then
  cd "$PROJECT" || exit
  ng serve --open
fi
